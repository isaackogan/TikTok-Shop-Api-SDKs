{
  "openapi": "3.1.0",
  "info": { "title": "mini", "version": "1" },
  "paths": {
    "/order/202309/orders/search": {
      "post": {
        "operationId": "getOrderList",
        "tags": ["Orders"],
        "x-tts-requires-shop-cipher": true,
        "parameters": [
          { "$ref": "#/components/parameters/ShopCipher" },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "format": "int64" } },
          { "name": "shop_id", "in": "query", "description": "Shop", "schema": { "type": "integer", "format": "int64" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OrderRequest" },
              "example": { "product_id": 1729507467923261408, "count": 3, "big": 7494049642642441621 }
            }
          }
        },
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/authorization/202309/shops": {
      "get": {
        "operationId": "getAuthorizedShops",
        "tags": ["Authorization"],
        "parameters": [{ "name": "app_key", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/chat/202309/conversations": {
      "get": {
        "operationId": "getConversationList",
        "tags": ["Mystery tools (beta)"],
        "x-tts-requires-shop-cipher": true,
        "parameters": [{ "$ref": "#/components/parameters/ShopCipher" }],
        "requestBody": {
          "content": { "application/json": { "schema": { "type": "object", "properties": { "count": { "type": "integer", "format": "int32" } } } } }
        },
        "responses": { "200": { "description": "ok" } }
      }
    }
  },
  "webhooks": {
    "order_status_change": {
      "post": {
        "operationId": "orderStatusChangeWebhook",
        "x-tts-webhook-type": 1,
        "x-tts-event-type": "ORDER_STATUS_CHANGE",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderStatusChangeWebhook" } } } }
      }
    },
    "package_update": {
      "post": {
        "operationId": "packageUpdateWebhook",
        "x-tts-webhook-type": 4,
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PackageUpdateWebhook" } } } }
      }
    }
  },
  "components": {
    "parameters": {
      "ShopCipher": { "name": "shop_cipher", "in": "query", "required": true, "schema": { "type": "string" } }
    },
    "schemas": {
      "OrderRequest": {
        "type": "object",
        "properties": {
          "product_id": { "type": "integer", "format": "int64", "description": "Product", "deprecated": true },
          "sku_ids": { "type": "array", "items": { "type": "integer", "format": "int64" } },
          "count": { "type": "integer", "format": "int32" },
          "big": { "type": ["integer", "null"], "format": "int64", "description": "Large" }
        }
      },
      "OrderStatusChangeWebhook": { "type": "object", "properties": { "shop_id": { "type": "string" } } },
      "PackageUpdateWebhook": { "type": "object", "properties": { "shop_id": { "type": "string" } } }
    }
  }
}
